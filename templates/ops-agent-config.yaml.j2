# The agent's own log files, shipped to Cloud Logging as ops-agent-fluent-bit,
# were ~40% of the agent's log volume (2 Oct) and nobody reads them. Its
# health checks (ops-agent-health) are separate and stay.
global:
  default_self_log_file_collection: false

logging:
  receivers:
    docker_logs:
      type: files
      include_paths:
        - /var/lib/docker/containers/*/*-json.log
  processors:
    # 1. Parse the JSON structure that Docker wraps logs in
    # (Docker lines look like: {"log":"{\"timestamp\":...}", "stream":"stdout", ...})
    parse_docker_wrapper:
      type: parse_json
      field: message

    # 2. Parse the actual JSON from your Deno app (contained in the 'log' field from above)
    parse_app_json:
      type: parse_json
      field: log
      # Using 'timestamp' helps Google Cloud place the log correctly in the timeline
      time_key: timestamp
      time_format: "%Y-%m-%dT%H:%M:%S.%LZ"

    # 3. Map severity levels (e.g. WARN -> WARNING) so the color indicators work in GCP
    move_severity:
      type: modify_fields
      fields:
        severity:
          move_from: jsonPayload.severity

  service:
    pipelines:
      default_pipeline:
        receivers: [docker_logs]
        processors: [parse_docker_wrapper, parse_app_json, move_severity]

# No host metrics: nobody reads them, and their collector (otelopscol) held
# ~57 MB on a 1 GB box. An empty receiver list is Google's documented way to
# turn the default metrics pipeline off; logging above is unaffected.
metrics:
  service:
    pipelines:
      default_pipeline:
        receivers: []
